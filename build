#!/bin/sh

if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root (use sudo)"
    exit 1
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
LOG_DIR="$SCRIPT_DIR/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/build-$(date +%Y%m%d-%H%M%S).log"
echo "Logging to $LOG_FILE"

update_channels() {
    VERSION=$(cat nixos-version)
    echo "Updating nix-channels to version $VERSION..."
    nix-channel --add https://nixos.org/channels/nixos-unstable nixos-unstable
    nix-channel --add "https://channels.nixos.org/nixos-$VERSION" nixos
    nix-channel --add "https://github.com/nix-community/home-manager/archive/release-$VERSION.tar.gz" home-manager
    nix-channel --add https://github.com/NixOS/nixos-hardware/archive/master.tar.gz nixos-hardware
    nix-channel --update
}

# Git, as the invoking user rather than as root. Git refuses to work in a repository owned by
# somebody else, and forcing it past that would leave root-owned objects behind in .git that break
# every later git command from a normal shell.
as_user_git() {
    if [ -n "$SUDO_USER" ]; then
        sudo -u "$SUDO_USER" git -C "$SCRIPT_DIR" "$@"
    else
        git -C "$SCRIPT_DIR" "$@"
    fi
}

update_submodules() {
    echo "Updating submodules..."
    # --recursive, not just --init: nix-assets has submodules of its own, and a plain --init
    # leaves those as empty directories that only fail much later, during evaluation, with a
    # path error that says nothing about submodules.
    #
    # --remote, and the checkout below: `submodule update` on its own checks out the exact commit
    # the superproject records and leaves HEAD detached, because a submodule is pinned to a commit
    # and not to a branch. That is right for a third-party dependency and wrong for these, which
    # are repositories we develop in — every rebuild quietly moved the checkout off `main` and back
    # onto whatever was pinned, so the next commit made there started from a detached HEAD several
    # commits behind, and the work already pushed looked as though it had vanished.
    as_user_git submodule update --init --recursive --remote

    # `--remote` fetches the branch and moves to its tip, still detached. This is what puts HEAD
    # back on the branch itself. Nothing is forced: a submodule with uncommitted work is left
    # exactly as it is and says so.
    as_user_git submodule foreach --recursive '
        branch=$(git config -f "$toplevel/.gitmodules" "submodule.$name.branch" 2>/dev/null || true)
        [ -n "$branch" ] || branch=main
        if ! git diff --quiet HEAD 2>/dev/null; then
            echo "  $displaypath: uncommitted changes, left detached"
        elif git checkout -q "$branch" 2>/dev/null; then
            git merge --ff-only -q "origin/$branch" 2>/dev/null || true
        else
            echo "  $displaypath: no branch '"'"'$branch'"'"', left detached"
        fi
    '

    # A submodule now tracking its branch can sit ahead of the commit the superproject records.
    # Said out loud rather than left to be noticed: the build uses what is checked out, so this is
    # the difference between what is being built and what the repository claims is being built.
    # `submodule status` marks a submodule whose checkout differs from the recorded commit with a
    # leading '+'. Asked this way rather than as a diff, which would also list every unrelated file
    # edited in the working tree and bury the one thing this is about.
    moved=$(as_user_git submodule status --recursive | sed -n 's/^+[0-9a-f]* \([^ ]*\).*/  \1/p')
    if [ -n "$moved" ]; then
        echo "Submodules moved ahead of what nixos-config records — commit the gitlink to pin it:"
        echo "$moved"
    fi
}

update_hardware_config() {
    if [ "$HOST" = "$(hostname)" ]; then
        HW_FILE="./src/hosts/hardware/$HOST.nix"
        echo "Regenerating hardware config: $HW_FILE"
        nixos-generate-config --show-hardware-config > "$HW_FILE"
    else
        echo "Skipping hardware config update (target host '$HOST' != current host '$(hostname)')"
    fi
}

{

update_submodules

echo "Copying assets..."
mkdir -p /etc/nixos/assets
cp ./nix-assets/* /etc/nixos/assets -r

COMMAND=$1
shift

SKIP_CHANNEL=false
SKIP_UPGRADE=false
SKIP_HARDWARE=false
HOST=$(hostname)

while [ $# -gt 0 ]; do
    case "$1" in
        --skip-channel) SKIP_CHANNEL=true ;;
        --skip-upgrade) SKIP_UPGRADE=true ;;
        --skip-hardware) SKIP_HARDWARE=true ;;
        *) HOST=$1 ;;
    esac
    shift
done

case "$COMMAND" in
    rebuild)
        if [ "$SKIP_CHANNEL" = false ]; then
            nix-channel --update
        fi

        if [ "$SKIP_HARDWARE" = false ]; then
            update_hardware_config
        fi

        UPGRADE_FLAG="--upgrade"
        if [ "$SKIP_UPGRADE" = true ]; then
            UPGRADE_FLAG=""
        fi

        echo "Rebuilding (switch) for host: $HOST"
        nixos-rebuild switch -I nixos-config="$(pwd)/src/hosts/$HOST.nix" $UPGRADE_FLAG
        ;;
    upgrade)
        update_channels
        if [ "$SKIP_HARDWARE" = false ]; then
            update_hardware_config
        fi
        echo "Upgrading (boot) for host: $HOST"
        nixos-rebuild boot -I nixos-config="$(pwd)/src/hosts/$HOST.nix" --upgrade
        ;;
    *)
        echo "Usage: sudo $0 {rebuild|upgrade} [hostname] [--skip-channel] [--skip-upgrade] [--skip-hardware]"
        echo "  rebuild: Runs nixos-rebuild switch"
        echo "  upgrade: Updates channels and runs nixos-rebuild boot --upgrade"
        echo "  --skip-channel: Skip 'nix-channel --update' during rebuild"
        echo "  --skip-upgrade: Skip '--upgrade' flag during rebuild"
        echo "  --skip-hardware: Skip regenerating src/hosts/hardware/<host>.nix"
        exit 1
        ;;
esac

} 2>&1 | while IFS= read -r line; do
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$line"
done | tee -a "$LOG_FILE"